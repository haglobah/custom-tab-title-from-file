{
  "manifest_version": 2,
  "name": "Custom Tab Title (from File)",
  "version": "2.1.0",
  "description": "Firefox web extension to change the title of any tab depending on regular expressions applied to the tab address URL",
  "icons": {
    "48": "icons/outline_folder_special_black_48dp.png",
    "96": "icons/outline_folder_special_black_96dp.png"
  },
  "permissions": [
    "<all_urls>",
    "tabs",
    "storage"
  ],
  "background": {
    "scripts": ["apply-rules.js"]
  },
  "options_ui": {
    "page": "options/options-page.html",
    "browser_style": true
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "custom-title-from-file@beathagenlocher.com",
      "strict_min_version": "58.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
